{
  "name": "create-distr-version-action",
  "description": "This action creates a new version of a Distr application",
  "version": "1.8.0",
  "license": "Apache-2.0",
  "type": "module",
  "private": true,
  "homepage": "https://distr.sh",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/distr-sh/create-distr-version-action.git"
  },
  "bugs": {
    "url": "https://github.com/distr-sh/create-distr-version-action/issues"
  },
  "keywords": [
    "actions"
  ],
  "packageManager": "pnpm@12.23.0",
  "engines": {
    "node": "26.x"
  },
  "scripts": {
    "build": "tsc && esbuild src/index.ts --bundle --platform=node --target=node24 --format=cjs --outfile=dist/index.cjs",
    "lint": "prettier --check --cache .",
    "format": "prettier --write --list-different --cache ."
  },
  "dependencies": {
    "@actions/core": "^3.0.1",
    "@distr-sh/distr-sdk": "^4.12.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.11",
    "esbuild": "^0.28.2",
    "prettier": "^3.10.1",
    "typescript": "^7.0.2"
  }
}
