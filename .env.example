# Inputs for running the action locally with `node --env-file=.env dist/index.cjs`.
# Do not commit your actual .env file to Git, it contains your API token.

# Inputs follow the `INPUT_<NAME>` format of GitHub Actions, keeping the hyphens of the input names.
INPUT_API-BASE=https://app.distr.sh/api/v1
INPUT_API-TOKEN=distr-...
INPUT_APPLICATION-ID=
INPUT_VERSION-NAME=v0.0.0-local

# Docker applications
INPUT_COMPOSE-FILE=

# Helm applications
# INPUT_CHART-TYPE=oci
# INPUT_CHART-URL=oci://ghcr.io/example/charts/app
# INPUT_CHART-VERSION=1.0.0

# Prints debug logs of @actions/core
RUNNER_DEBUG=1
